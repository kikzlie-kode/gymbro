# Local emulator only. Copy to functions/.env and fill in real values.
#
# LINE_CHANNEL_ACCESS_TOKEN, LINE_CHANNEL_SECRET, LIFF_CHANNEL_ID are secrets —
# for production, do NOT rely on a deployed .env for these; set them with
# `firebase functions:secrets:set <NAME>` instead (see README).
#
# LIFF_URL is not sensitive and is fine to deploy via functions/.env as-is.

LINE_CHANNEL_ACCESS_TOKEN=your-messaging-api-channel-access-token
LINE_CHANNEL_SECRET=your-messaging-api-channel-secret
LIFF_CHANNEL_ID=your-liff-channel-id
LIFF_URL=https://liff.line.me/your-liff-id
